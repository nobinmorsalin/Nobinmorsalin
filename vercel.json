{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/api/contact", "destination": "/api/contact.js" },
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/sitemap.xml", "destination": "/api/portfolio?format=sitemap" },
    { "source": "/robots.txt", "destination": "/api/portfolio?format=robots" },
    { "source": "/projects/:slug", "destination": "/index.html" },
    { "source": "/services/:slug", "destination": "/index.html" },
    { "source": "/clients/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    }
  ]
}
